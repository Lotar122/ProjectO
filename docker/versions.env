# Versions and base image digests for docker/archiver-worker.Dockerfile.
# Plain KEY=value lines, so the file can be sourced by a shell:
#   set -a; . docker/versions.env; set +a
# and each value passed with `docker build --build-arg NAME` (see README, "Worker archiwizacji").
#
# Digests are those of the multi-arch image index (linux/amd64 and linux/arm64 among others),
# read from the Docker Hub registry API on 2026-11-19 (Docker-Content-Digest header of
# GET /v2/<repo>/manifests/<tag>, anonymous token from auth.docker.io), and checked as the
# sha256 of the manifest body. To refresh one, repeat the call from the README and change the
# tag and the digest together in a reviewed commit. Never edit a digest by hand.

# Bun: MUST equal the Bun of the web image. The web image is not in this repo, so this is the
# version the repo runs on (bun 1.4.4, `bun --version`). OWNER: confirm it against the web image
# (`docker run --rm --entrypoint bun <web-image> --version`). The worker decodes with
# node:zlib through createDecompressStream, which is the same code the web download route uses,
# and a different Bun can mean a different libzstd/brotli decoder.
BUN_VERSION=1.4.4

# oven/bun:${BUN_VERSION}-alpine, used for the deps stage and the runtime stage.
BUN_ALPINE_DIGEST=sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a

# alpine:${ALPINE_VERSION}, used only to build and test projecto-compress (native stage).
# The binary is a static-pie, so the build image does not have to match the runtime image.
ALPINE_VERSION=3.24
ALPINE_DIGEST=sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
