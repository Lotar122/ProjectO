# Docker build context for the web image (docker/web-supervised.Dockerfile), built from the repo root.

# secrets: never reach an image layer
.env
.env.*
**/.env
**/.env.*

# VCS and tooling. "**/" also matches at the root and in every subfolder
# (graphify writes src/graphify-out, worker/graphify-out and deeper ones).
.git
.gitignore
**/.claude
**/.codex
**/.vscode
**/graphify-out
**/phases-bugfix

# dependencies and build output (each image installs and builds its own)
**/node_modules
**/.next
out
**/coverage

# archiver recovery files are data, not source
archiver-recovery
**/archiver-recovery

# native/compressor build trees (cmake/ holds sources and is kept)
/build
/build-*
native/**/build
native/**/build-*
native/**/cmake-build-*
native/**/CMakeFiles
native/**/CMakeCache.txt

# keys and credentials
**/*.pem
**/*.key
.npmrc
.netrc

# editor and OS noise
**/*.log
**/.DS_Store
CLAUDE.md.bak-*
