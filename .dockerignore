# Docker build context for every image built from the repo root (the archiver worker and,
# if it uses the repo root as its context, the web image).

# secrets: never reach an image layer
.env
.env.*
**/.env
**/.env.*

# VCS and tooling
.git
.gitignore
.claude
.codex
.vscode
graphify-out
phases-bugfix

# dependencies and build output (each image installs and builds its own)
node_modules
**/node_modules
.next
out
coverage

# archiver recovery files are data, not source
archiver-recovery
**/archiver-recovery

# native/compressor build trees (cmake/ holds sources and is kept)
/build
/build-*
native/**/build
native/**/build-*
native/**/cmake-build-*
native/**/CMakeFiles
native/**/CMakeCache.txt

# keys and credentials
**/*.pem
**/*.key
.npmrc
.netrc

# editor and OS noise
**/*.log
**/.DS_Store
CLAUDE.md.bak-*
